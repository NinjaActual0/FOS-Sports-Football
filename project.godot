; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name=\"FOS Sports Football\"
run/main_scene=\"res://src/ui/MainMenu.tscn\"
config/features=PackedStringArray(\"4.5\", \"Forward Plus\")
config/icon=\"res://icon.svg\"

[autoload]

GameManager=\"*res://src/core/GameManager.gd\"
InputManager=\"*res://src/input/InputManager.gd\"
PhysicsManager=\"*res://src/physics/PhysicsManager.gd\"
EnvironmentManager=\"*res://src/environment/EnvironmentManager.gd\"
HealthManager=\"*res://src/core/HealthManager.gd\"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true

[input]

move_forward={\"deadzone\":0.5,\"events\":[{\"button_index\":0,\"device\":-1,\"type\":\"joypad_button\"},{\"keycode\":87,\"type\":\"key\"}]}
move_backward={\"deadzone\":0.5,\"events\":[{\"button_index\":13,\"device\":-1,\"type\":\"joypad_button\"},{\"keycode\":83,\"type\":\"key\"}]}
move_left={\"deadzone\":0.5,\"events\":[{\"button_index\":14,\"device\":-1,\"type\":\"joypad_button\"},{\"keycode\":65,\"type\":\"key\"}]}
move_right={\"deadzone\":0.5,\"events\":[{\"button_index\":15,\"device\":-1,\"type\":\"joypad_button\"},{\"keycode\":68,\"type\":\"key\"}]}
snap={\"deadzone\":0.5,\"events\":[{\"button_index\":0,\"device\":-1,\"type\":\"joypad_button\"},{\"keycode\":32,\"type\":\"key\"}]}
pass={\"deadzone\":0.5,\"events\":[{\"button_index\":2,\"device\":-1,\"type\":\"joypad_button\"},{\"mouse_button_index\":1,\"type\":\"mouse_button\"}]}
run={\"deadzone\":0.5,\"events\":[{\"button_index\":1,\"device\":-1,\"type\":\"joypad_button\"},{\"keycode\":16777237,\"type\":\"key\"}]}
tackle={\"deadzone\":0.5,\"events\":[{\"button_index\":2,\"device\":-1,\"type\":\"joypad_button\"},{\"mouse_button_index\":1,\"type\":\"mouse_button\"}]}
coach_mode={\"deadzone\":0.5,\"events\":[{\"button_index\":4,\"device\":-1,\"type\":\"joypad_button\"},{\"keycode\":67,\"type\":\"key\"}]}
pause={\"deadzone\":0.5,\"events\":[{\"button_index\":6,\"device\":-1,\"type\":\"joypad_button\"},{\"keycode\":4194305,\"type\":\"key\"}]}

[layer_names]

3d_physics/layer_1=\"world\"
3d_physics/layer_2=\"players\"
3d_physics/layer_3=\"ball\"
3d_physics/layer_4=\"environment\"

[physics]

3d/physics_engine=\"JoltPhysics\"

[rendering]

renderer/rendering_method=\"forward_plus\"
